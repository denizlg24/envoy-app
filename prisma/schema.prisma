generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String   @id @default(uuid())
  email     String?  @unique
  githubId  String   @unique
  createdAt DateTime @default(now())

  projects  ProjectMember[]
  apiTokens ApiToken[]
}

model Project {
  id               String          @id @default(uuid())
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @default(now())
  head_commit_hash String          @default("")
  members          ProjectMember[]
}

model ProjectMember {
  userId    String
  projectId String
  role      String
  nickname  String?
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, projectId])
}

model ApiToken {
  id        String    @id @default(uuid())
  hash      String    @unique
  userId    String
  createdAt DateTime  @default(now())
  revokedAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model HealthCheck {
  id           String   @id @default(uuid())
  timestamp    DateTime @default(now())
  
  // Overall status
  healthy      Boolean
  responseTime Int?     // in milliseconds
  
  // Individual service status
  dbHealthy       Boolean
  dbResponseTime  Int?
  r2Healthy       Boolean
  r2ResponseTime  Int?
  ghHealthy       Boolean
  ghResponseTime  Int?

  @@index([timestamp])
}

model ApiRequest {
  id           String   @id @default(uuid())
  timestamp    DateTime @default(now())
  
  method       String   // GET, POST, etc.
  path         String   // /api/projects, etc.
  statusCode   Int
  responseTime Int      // in milliseconds
  error        String?  // Error message if failed

  @@index([timestamp])
  @@index([path])
}
